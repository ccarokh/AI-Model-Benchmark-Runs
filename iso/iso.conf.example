# Copy to iso.conf and fill in. THIS FILE IS NOT IN GIT, and that is the point:
# it carries the address of a tunnel endpoint, a WireGuard key and an SSH public
# key. The build script refuses to run without it rather than inventing defaults.

[tunnel]
# The hub the borrowed machine dials OUT to. It sits behind somebody else's
# router, so nothing can reach in -- the connection is only ever built from
# there to here.
hub_endpoint = vpn.example.org:51820
# The hub's WireGuard public key. Public, but still nobody else's business.
hub_public_key =
# The address the borrowed machine gets inside the overlay, and the hub's own.
# A /32 for the guest is deliberate: it may talk to the hub and to nothing else.
guest_ip = 10.10.0.90
hub_ip = 10.10.0.1
overlay_cidr = 10.10.0.0/24

[access]
# The public half of the key pair you will use to reach the machine. Nothing
# else is allowed in: the live system has no password and no other user.
ssh_public_key =

[models]
# Downloaded on FIRST BOOT, over the borrowed machine's own connection.
# name|huggingface repo|file -- one per line, indented.
#
# The default set is what fits an 11 GB card with room for context, and it is
# chosen so the numbers land next to existing rows in data/testbench/. The first
# entry is the reference workload: -p 2048 -n 128, upstream's own flags, the one
# that carries the memory-bandwidth comparison.
models =
    llama-3.2-3b|bartowski/Llama-3.2-3B-Instruct-GGUF|Llama-3.2-3B-Instruct-Q4_K_M.gguf
    qwen3.5-9b|unsloth/Qwen3.5-9B-GGUF|Qwen3.5-9B-Q4_K_M.gguf
    gemma-4-12b|unsloth/gemma-4-12b-it-GGUF|gemma-4-12b-it-Q4_K_M.gguf
    ling-3.0-tiny|inclusionAI/Ling-3.0-tiny-GGUF|Ling-3.0-tiny-Q4_K_M.gguf

[build]
# The llama.cpp the measurements run on. Comparability lives and dies here: a
# figure from another version compares versions, not cards. b10273 is the pinned
# measurement build behind every llama-bench number in data/testbench/.
llama_cpp_ref = b10273
llama_cpp_repo = https://github.com/ggml-org/llama.cpp
